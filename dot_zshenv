# Sourced by every zsh invocation (interactive, non-interactive, scripts, subshells).
# Keep this file FAST — no network/op calls, no Touch ID prompts.

# Ensure homebrew bin is on PATH so tools like `op` resolve from any shell context
[[ ":$PATH:" != *":/opt/homebrew/bin:"* ]] && export PATH="/opt/homebrew/bin:$PATH"
