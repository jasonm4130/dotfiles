# Managed by chezmoi. Private key material lives in 1Password, never on disk:
# the agent serves signatures over this socket, so `~/.ssh` holds no id_* files
# and a lost laptop leaks nothing. Requires 1Password → Settings → Developer →
# "Use the SSH agent"; without it the socket is absent and ssh falls back to
# the system agent, which has no keys — the failure reads as "Permission
# denied (publickey)" and names neither 1Password nor the toggle.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Some networks block port 22; GitHub also serves SSH on 443. Use it by hand
# with `git@github-443:owner/repo` when 22 is blocked. There is deliberately
# no automatic `nc` probe: each probe is an extra SYN to github.com:22, and
# the home UniFi IPS (ET sid 2003068) blocks a destination after 5 SYNs in
# 120 s from one source, which is what made fleet git flaky.
Host github-443
  HostName ssh.github.com
  Port 443
  User git
  HostKeyAlias github.com

Host github.com
  User git
  # Share one connection across parallel git operations so a busy fleet
  # sends one SYN per 10 minutes instead of one per fetch or push.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  # 1Password prompts for Touch ID on first use per session, then caches.

# Firstmate's route to its remote second-mate home on dell-01 (the isolated fm
# Incus container, brok-stacks nodes/README.md "fm instance"). A dedicated
# on-disk key so supervision never waits on a 1Password prompt; its reach is
# that sandbox only.
Host fm-dell01
  # dell-01's tailnet name works at home and away; HostKeyAlias keeps the
  # existing known_hosts entry. 192.168.5.20 on the same port is the fallback.
  HostName dell-01
  HostKeyAlias [192.168.5.20]:2222
  Port 2222
  User fm
  IdentityFile ~/.ssh/fm-dell01
  IdentitiesOnly yes
  IdentityAgent none
  ForwardAgent no
  StrictHostKeyChecking yes

Host fm-dell02
  # endurebyte's second mate on dell-02 (brok-stacks #443). Same shape as
  # fm-dell01; 192.168.5.21 on the same port is the fallback.
  HostName dell-02
  HostKeyAlias [192.168.5.21]:2222
  Port 2222
  User fm
  IdentityFile ~/.ssh/fm-dell02
  IdentitiesOnly yes
  IdentityAgent none
  ForwardAgent no
  StrictHostKeyChecking yes

