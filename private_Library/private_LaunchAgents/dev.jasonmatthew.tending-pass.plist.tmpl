<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.jasonmatthew.tending-pass</string>

    <!-- Tending's 60 s pass, always from the promoted release, never a working tree. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/share/tending/current/tending</string>
        <string>pass</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/tending/logs/pass.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/tending/logs/pass.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
