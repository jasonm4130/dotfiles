<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.jasonmatthew.vault-autosync</string>

    <!-- The helper app, not the script: it holds the Full Disk Access grant
         that ~/Documents needs, and runs only vault-autosync.sh
         (run_onchange_after_21 builds it and explains). -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/Applications/VaultAutosync.app/Contents/MacOS/vault-autosync-helper</string>
    </array>

    <key>AssociatedBundleIdentifiers</key>
    <string>dev.jasonmatthew.vault-autosync-helper</string>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- The script logs to this file itself (and rotates it); launchd only
         catches anything printed before it gets that far. -->
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/vault-autosync.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/vault-autosync.log</string>
</dict>
</plist>
