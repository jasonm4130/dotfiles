<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.jasonmatthew.ships-log-shipper</string>

    <!-- Long-running: `run` ships until SIGTERM. The compiled binary needs no node. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/ships-log-shipper</string>
        <string>run</string>
        <string>--config</string>
        <string>{{ .chezmoi.homeDir }}/.config/ships-log/shipper.json</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart after a crash, at most once a minute. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <!-- Counts and error codes only; transcript content is never logged. -->
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/ships-log-shipper.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/ships-log-shipper.log</string>
</dict>
</plist>
