<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.jasonmatthew.wiki-sync</string>

    <!-- ~/Work/Git is outside the TCC-protected folders, so unlike
         vault-autosync this needs no Full Disk Access helper app. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/.local/bin/wiki-sync.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <!-- The script logs to this file itself (and rotates it); launchd only
         catches anything printed before it gets that far. -->
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/wiki-sync.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/wiki-sync.log</string>
</dict>
</plist>
