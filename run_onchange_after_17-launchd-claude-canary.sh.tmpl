#!/usr/bin/env bash
# Reloads when the plist changes: {{ include "private_Library/private_LaunchAgents/dev.jasonmatthew.claude-canary.plist.tmpl" | sha256sum }}
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/dev.jasonmatthew.claude-canary.plist"

echo "🔁 (Re)loading claude-canary launchd agent"
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load -w "$PLIST"
echo "✅ claude-canary agent loaded"
