{
  "env": {
    "HANDOFF_EFFECTIVE_MAX_TOKENS": "400000",
    "HANDOFF_THRESHOLD_PCT": "999",
    "CLAUDE_CODE_PLUGIN_KEEP_MARKETPLACE_ON_FAILURE": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "TZ": "Australia/Brisbane",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "RETRO_BATCH_MIN_SESSIONS": "15",
    "RETRO_BATCH_MIN_DAYS": "0",
    "RETRO_BATCH_MAX_SESSIONS": "20"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(which:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(uv:*)",
      "Bash(wrangler:*)",
      "Bash(brew:*)",
      "Bash(docker:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(seq:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(for:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "WebFetch(domain:zed.dev)",
      "mcp__exa__web_search_exa",
      "mcp__exa__web_fetch_exa",
      "mcp__tavily__tavily_search"
    ],
    "deny": [
      "Skill(deep-research)",
      "Skill(deep-research *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disabledMcpjsonServers": [],
  "skillOverrides": {
    "deep-research": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/lsp-first-guard.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/secrets-scan.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/disk-guard.sh pretool"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 6
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/json-config-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 4
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/tab-title.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/tab-title.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/handoff-statusline.mjs"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "deep-dive@jasonm4130-claude-skills": true,
    "handoff@jasonm4130-claude-skills": true,
    "session-retro@jasonm4130-claude-skills": true,
    "workflow-model-guard@jasonm4130-claude-skills": true,
    "subagent-driven-development@jasonm4130-claude-skills": true,
    "adr@jasonm4130-claude-skills": true,
    "ship-gate@jasonm4130-claude-skills": true,
    "docs-sync-guard@jasonm4130-claude-skills": true,
    "codex-review@jasonm4130-claude-skills": true,
    "superpowers-core@jasonm4130-claude-skills": true,
    "frontend-design@jasonm4130-claude-skills": true,
    "design-gate-guard@jasonm4130-claude-skills": true,
    "claude-design@jasonm4130-claude-skills": true,
    "codebase-design@jasonm4130-claude-skills": true,
    "writing-artifacts@jasonm4130-claude-skills": true,
    "domain-modeling@jasonm4130-claude-skills": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "jasonm4130-claude-skills": {
      "source": {
        "source": "github",
        "repo": "jasonm4130/claude-skills"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "askUserQuestionTimeout": "5m",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
