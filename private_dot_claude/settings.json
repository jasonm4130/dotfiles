{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "effortLevel": "medium",
  "autoCompactWindow": 300000,
  "modelSettings": {
    "claude-haiku-5-5": {
      "autoCompactWindow": 200000
    }
  },
  "teammateMode": "in-process",
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline-tee"
  },
  "permissions": {
    "allow": [
      "Read(~/Code/**)",
      "Read(~/.local/share/chezmoi/**)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/op/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.netrc)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.*.local)",
      "Edit(~/.ssh/**)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)"
    ],
    "ask": [
      "Bash(gh pr merge *--admin*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(chezmoi apply)",
      "Bash(chezmoi apply --force)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "**Trusted repo**: any git checkout under ~/Code whose origin is under github.com/jasonm4130 or github.com/jasonm4130-labs, plus the chezmoi source at ~/.local/share/chezmoi (origin github.com/jasonm4130/dotfiles) and the files it renders under $HOME",
      "**Secrets management**: 1Password; secrets reach commands via `op run --env-file .env.op -- <command>`, never plaintext",
      "**Additional context**: Solo developer on a private laptop; no employer data on this machine. Commits, pushes and `gh pr merge --merge` on the trusted repos are routine; `--admin` merges and force pushes are not"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "grok-build@xai-grok-build": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "xai-grok-build": {
      "source": {
        "source": "github",
        "repo": "xai-org/grok-build-plugin-cc"
      }
    }
  },
  "outputStyle": "Concise",
  "theme": "dark",
  "tui": "fullscreen"
}
