{
  "name": "ts-lsp",
  "description": "TypeScript LSP: the project's TS 7 `tsc --lsp` when present, else typescript-language-server",
  "version": "1.0.0",
  "lspServers": {
    "typescript": {
      "command": "ts-lsp",
      "args": [],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
