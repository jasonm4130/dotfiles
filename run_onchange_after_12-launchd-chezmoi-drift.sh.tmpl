#!/usr/bin/env bash
# Reloads when the plist changes: {{ include "private_Library/private_LaunchAgents/dev.jasonmatthew.chezmoi-drift.plist.tmpl" | sha256sum }}
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/dev.jasonmatthew.chezmoi-drift.plist"

echo "🔁 (Re)loading chezmoi-drift launchd agent"
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load -w "$PLIST"
echo "✅ chezmoi-drift agent loaded"
