#!/usr/bin/env bash
# Reloads when the plist changes: {{ include "private_Library/private_LaunchAgents/dev.jasonmatthew.daily-notes-update.plist" | sha256sum }}
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/dev.jasonmatthew.daily-notes-update.plist"

echo "🔁 (Re)loading daily-notes-update launchd agent"
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load -w "$PLIST"
echo "✅ daily-notes-update agent loaded"
