#!/usr/bin/env bash
# Reloads when the plist changes: {{ include "private_Library/private_LaunchAgents/dev.jasonmatthew.tending-quota.plist.tmpl" | sha256sum }}
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/dev.jasonmatthew.tending-quota.plist"

mkdir -p "$HOME/.local/state/tending/logs"
echo "🔁 (Re)loading tending-quota launchd agent"
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load -w "$PLIST"
echo "✅ tending-quota agent loaded"
