# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git npm node zsh-autosuggestions zsh-syntax-highlighting docker docker-compose gcloud)
source $ZSH/oh-my-zsh.sh

# Tab titles — omz termsupport owns them (Ghostty's own title integration is
# disabled via shell-integration-features = no-title). Idle shows the cwd;
# a running command (incl. Claude Code, which writes its own task summary)
# takes over the title while it runs. Must be set AFTER sourcing oh-my-zsh —
# termsupport assigns these unconditionally at load.
ZSH_THEME_TERM_TAB_TITLE_IDLE='%~'
ZSH_THEME_TERM_TITLE_IDLE='%~'

# mise — version manager (replaces Volta + pyenv)
eval "$(mise activate zsh)"

# PATH — Google Cloud SDK
export PATH="$HOME/google-cloud-sdk/bin:$PATH"
source "$HOME/google-cloud-sdk/completion.zsh.inc" 2>/dev/null

# PATH — LM Studio
export PATH="$PATH:$HOME/.cache/lm-studio/bin"

# Secrets via 1Password CLI — op-fast caches in macOS Keychain to skip per-tty Touch ID.
# Covers non-login interactive shells, which never source .zprofile. In a normal
# tab both run and the sentinel makes the second a no-op.
[ -r "$HOME/.config/op/load-env.zsh" ] && source "$HOME/.config/op/load-env.zsh"

# Aliases
alias zshconfig="code ~/.zshrc"
alias ohmyzsh="code ~/.oh-my-zsh"
alias code="/opt/homebrew/bin/code-insiders"
alias c="code ."
alias vim="nvim"
alias vi="nvim"
alias g="git"

# bun completions
[ -s "/Users/jasonmatthew/.bun/_bun" ] && source "/Users/jasonmatthew/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

alias claude-mem='bun "/Users/jasonmatthew/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-service.cjs"'
export PATH="$HOME/.local/bin:$PATH"

# Starship prompt
eval "$(starship init zsh)"

# direnv — per-directory env (e.g. ~/Work/Git/unifi secrets via 1Password/op-fast)
# Must stay after prompt setup (starship) per direnv docs.
eval "$(direnv hook zsh)"
