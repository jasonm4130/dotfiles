#!/usr/bin/env bash
# Installs the Dells k3s kubeconfig from 1Password into ~/.kube/dells.yaml
# (0600). KUBECONFIG points at it (dot_zshenv).
#
#   kubeconfig-install
#
# chezmoi runs this from run_onchange_after_21 when this script changes. Run
# it by hand after the kubeconfig is rotated in 1Password: a 1Password change
# does not re-trigger run_onchange.
#
# The document travels only through `op document get --out-file` into a file
# created under umask 077; nothing is echoed. No op, a locked 1Password or a
# missing document is a clean skip, never a failed apply.
set -euo pipefail

VAULT="${KUBECONFIG_OP_VAULT:-Private}"
ITEM="${KUBECONFIG_OP_ITEM:-k3s dells kubeconfig}"
DEST="$HOME/.kube/dells.yaml"
OP=/opt/homebrew/bin/op   # plain op: keep the admin kubeconfig out of op-fast's cache

skip() { echo "⏭  kubeconfig: $*" >&2; exit 0; }
[ -x "$OP" ] || skip "1Password CLI not found; install it and re-run: kubeconfig-install"

umask 077
mkdir -p "$HOME/.kube"
tmp=$(mktemp -d "$HOME/.kube/.install.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

if ! "$OP" document get "$ITEM" --vault "$VAULT" --out-file "$tmp/dells.yaml" >/dev/null; then
  skip "could not read document '$ITEM' in vault $VAULT (missing, or 1Password locked). Re-run: kubeconfig-install"
fi
grep -q '^kind: Config' "$tmp/dells.yaml" || skip "document '$ITEM' is not a kubeconfig; left $DEST as it was"

chmod 600 "$tmp/dells.yaml"
mv -f "$tmp/dells.yaml" "$DEST"
echo "✅ kubeconfig installed at $DEST"
