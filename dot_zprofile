# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# mise shims for GUI-launched processes (Zed MCP servers etc.)
eval "$(mise activate zsh --shims)"

# Google Cloud SDK — use mise-managed Python
export CLOUDSDK_PYTHON="$(mise which python 2>/dev/null || echo /usr/bin/python3)"

# MCP secrets via 1Password. Login shell, so GUI apps launched FROM A TERMINAL
# inherit these; an app started from the Dock or Finder never sources this file
# and sees none of them — use `op run` in that app's own config instead.
# Shared with .zshrc; the sentinel inside keeps it to one inject per tab.
[ -r "$HOME/.config/op/load-env.zsh" ] && source "$HOME/.config/op/load-env.zsh"
