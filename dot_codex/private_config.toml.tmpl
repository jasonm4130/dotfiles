{{- $live := dict -}}
{{- $path := joinPath .chezmoi.homeDir ".codex/config.toml" -}}
{{- if stat $path -}}
{{- $live = fromToml (include $path) -}}
{{- end -}}
{{- $features := get $live "features" | default dict -}}
{{- $_ := set $features "memories" true -}}
{{- $_ := set $live "features" $features -}}
{{- $memories := get $live "memories" | default dict -}}
{{- $_ := set $memories "generate_memories" true -}}
{{- $_ := set $memories "use_memories" true -}}
{{- $_ := set $memories "min_rate_limit_remaining_percent" 25 -}}
{{- $_ := set $live "memories" $memories -}}
{{- $mcp := get $live "mcp_servers" | default dict -}}
{{- range $name, $url := dict "openaiDeveloperDocs" "https://developers.openai.com/mcp" "cloudflare-docs" "https://docs.mcp.cloudflare.com/mcp" -}}
{{- if not (hasKey $mcp $name) -}}
{{- $_ := set $mcp $name (dict "url" $url "enabled" true "startup_timeout_sec" 30 "tool_timeout_sec" 60) -}}
{{- end -}}
{{- end -}}
{{- if not (hasKey $mcp "chrome-devtools") -}}
{{- $_ := set $mcp "chrome-devtools" (dict "command" "npx" "args" (list "--offline" "--yes" "chrome-devtools-mcp@1.8.0" "--isolated" "--headless" "--no-usage-statistics" "--no-performance-crux") "enabled" true "startup_timeout_sec" 30 "tool_timeout_sec" 60) -}}
{{- end -}}
{{- $_ := set $live "mcp_servers" $mcp -}}
{{- $tui := get $live "tui" | default dict -}}
{{- if not (hasKey $tui "status_line") -}}
{{- $_ := set $tui "status_line" (list "model-with-reasoning" "context-remaining" "current-dir" "five-hour-limit" "weekly-limit") -}}
{{- $_ := set $live "tui" $tui -}}
{{- end -}}
# Ordinary launches use the Astra work loop; worker callers select explicit profiles.
# Keep background callers explicit about their model.
model = "gpt-6-astra"
model_reasoning_effort = "medium"
approvals_reviewer = "auto_review"
project_doc_fallback_filenames = ["CLAUDE.md"]
developer_instructions = """
Use the work-loop skill at ~/.codex/skills/work-loop/SKILL.md for substantive code work.
Act as the orchestrator: own scope, delegate bounded implementation, resolve advisor requests,
and accept changes using observed checks and fresh review. Handle trivial edits directly.
"""

# Preserve settings written by Codex (hook trust, projects, UI and integrations).
# The defaults above, worker routing, and native memory settings with their 25%
# quota reserve are owned by this template. Other runtime state stays
# on this machine, rather than copying trusted hashes into the dotfiles repo.
# New machines also get a quota-aware status line; existing choices survive.
# Seed documentation MCPs if absent; preserve their later local customization.
{{- $agents := get $live "agents" | default dict -}}
{{- $_ := set $agents "default_subagent_model" "gpt-5.6-terra" -}}
{{- $_ := set $agents "default_subagent_reasoning_effort" "medium" -}}
{{- $_ := set $agents "max_concurrent_threads_per_session" 3 -}}
{{- $_ := set $live "agents" $agents }}
{{ toToml (omit $live "model" "model_reasoning_effort" "approvals_reviewer" "project_doc_fallback_filenames" "developer_instructions") -}}
