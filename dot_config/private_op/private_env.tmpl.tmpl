# Resolved by `op inject` at shell startup. Contains only references, never secrets.
export TAVILY_API_KEY="op://Private/tavily-api/credential"
export TURBO_TOKEN="op://Private/turbo/token"
export TURBO_TEAM="op://Private/turbo/team"
export TURBO_REMOTE_CACHE_SIGNATURE_KEY="op://Private/turbo/signature"
export MOONSHOT_API_KEY="op://Private/Moonshot AI/credential"

# STRIPE_SECRET_KEY is intentionally NOT loaded at startup: its 15m op-fast TTL
# would trigger a 1Password prompt every ~15 min on new shells. Load on demand:
#   export STRIPE_SECRET_KEY=$(op-fast read op://Private/stripe-secret/credential)

# CLOUDFLARE_API_TOKEN is intentionally NOT loaded at startup: an exported token
# takes precedence over `wrangler login` OAuth. The cloudflare MCP servers OAuth
# separately (type:http, no env) and are unaffected. Load on demand only for
# non-interactive REST/CI use:
#   export CLOUDFLARE_API_TOKEN=$(op-fast read op://Private/cloudflare-api/credential)
