#!/usr/bin/env bash
# Reloads when the plist changes: {{ include "private_Library/private_LaunchAgents/dev.jasonmatthew.agents-quota-push.plist.tmpl" | sha256sum }}
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/dev.jasonmatthew.agents-quota-push.plist"

echo "🔁 (Re)loading agents-quota-push launchd agent"
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load -w "$PLIST"
echo "✅ agents-quota-push agent loaded"
